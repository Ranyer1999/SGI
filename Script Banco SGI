CREATE database sgi

use sgi

-- Primeiro: criar tabelas independentes (sem chaves estrangeiras)
CREATE TABLE grupo_acesso 
( 
 idgrupo_acesso INT PRIMARY KEY AUTO_INCREMENT,
 nome_grupo VARCHAR(50) NOT NULL,  
 desc_grupo varchar(255)
); 

CREATE TABLE status_curso 
( 
 idstatus_curso INT PRIMARY KEY AUTO_INCREMENT,
 nome_stcurso ENUM('Ativo', 'Inativo', 'Em elaboração') NOT NULL  
); 

CREATE TABLE turno 
( 
 idturno INT PRIMARY KEY AUTO_INCREMENT,
 nome_turno ENUM('Matutino', 'Vespertino', 'Noturno') NOT NULL 
); 

CREATE TABLE status_turma 
( 
 idstatus_turma INT PRIMARY KEY AUTO_INCREMENT,
 nome_stturma ENUM('Aberta', 'Concluída', 'Cancelada') NOT NULL
); 

CREATE TABLE componente 
( 
 idcomponente INT PRIMARY KEY AUTO_INCREMENT,
 nome_componente VARCHAR(100) NOT NULL,
 cargahr_comp INT NOT NULL,
 comp_socioemocional TEXT,
 base_conhecimentos TEXT,
 habilidades TEXT
); 

CREATE TABLE status_alocacao 
( 
 idstatus_alocacao INT PRIMARY KEY AUTO_INCREMENT,
 nome_stalocacao ENUM('Ativa', 'Encerrada', 'Cancelada') NOT NULL  
); 

CREATE TABLE status_candidatura 
( 
 idstatus_candidatura INT PRIMARY KEY AUTO_INCREMENT,  
 nome_statuscand ENUM('Pendente', 'Aceita', 'Recusada') NOT NULL  
); 

-- Segundo: criar tabelas que dependem das anteriores
CREATE TABLE usuario 
( 
 idusuario INT PRIMARY KEY AUTO_INCREMENT,  
 idgrupo_acesso INT NOT NULL,  
 user_login VARCHAR(100) UNIQUE NOT NULL,
 senha VARCHAR(12) NOT NULL,
 dt_criacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP
); 

CREATE TABLE curso 
( 
 idcurso INT PRIMARY KEY AUTO_INCREMENT,  
 nome_curso VARCHAR(150) NOT NULL,
 tipo_curso ENUM('Técnico', 'Qualificação', 'Especialização') NOT NULL,
 cargahr_curso INT NOT NULL,
 idstatus_curso INT NOT NULL
); 

-- Terceiro: criar tabelas que dependem de usuario
CREATE TABLE professor 
( 
 idprofessor INT PRIMARY KEY AUTO_INCREMENT,  
 nome_prof VARCHAR(150) NOT NULL,
 cpf CHAR(14) UNIQUE NOT NULL,
 telefone VARCHAR(15),
 dt_nascimento DATE,
 email_prof VARCHAR(100) UNIQUE,
 idusuario INT NOT NULL
); 

CREATE TABLE coordenador 
( 
 idcoordenador INT PRIMARY KEY AUTO_INCREMENT, 
 idusuario INT NOT NULL 
); 

CREATE TABLE administrador 
( 
 idadmin INT PRIMARY KEY AUTO_INCREMENT,  
 idusuario INT NOT NULL 
);

-- Quarto: criar tabelas que dependem de curso e componente
CREATE TABLE grade_curricular 
( 
 idgrade_curricular INT PRIMARY KEY AUTO_INCREMENT,  
 status_grade ENUM('Ativo', 'Inativo') NOT NULL,
 dt_vigencia DATE NOT NULL,
 idcomponente INT NOT NULL,
 idcurso INT NOT NULL
); 

-- Quinto: criar tabelas que dependem de professor
CREATE TABLE formacao_professor 
( 
 idformacao INT PRIMARY KEY AUTO_INCREMENT,
 nome_formacao VARCHAR(150) NOT NULL,
 tipo_formacao ENUM('Graduação', 'Especialização', 'Mestrado', 'Doutorado') NOT NULL,
 instituicao VARCHAR(150) NOT NULL,
 ano_conclusao YEAR NOT NULL,
 cargahr_formacao INT NOT NULL,
 idprofessor INT NOT NULL
); 

-- Sexto: criar turma (depende de várias tabelas)
CREATE TABLE turma 
( 
 idturma INT PRIMARY KEY AUTO_INCREMENT,
 nome_turma VARCHAR(100),
 dt_inicio DATE,
 dt_fim DATE, 
 idstatus_turma INT NOT NULL,  
 idturno INT NOT NULL,   
 idgrade_curricular INT NOT NULL,  
 idcurso INT NOT NULL
); 

-- Sétimo: criar tabelas que dependem de turma e professor
CREATE TABLE alocacao 
( 
 idalocacao INT PRIMARY KEY AUTO_INCREMENT,
 dt_alocacao DATE NOT NULL,  
 idstatus_alocacao INT NOT NULL,
 idprofessor INT NOT NULL, 
 idturma INT NOT NULL,
 idcomponente INT NOT NULL,
 periodo_inicio DATE,
 periodo_fim DATE
); 

CREATE TABLE candidatura 
( 
 idcandidatura INT PRIMARY KEY AUTO_INCREMENT,
 dt_candidatura DATE NOT NULL,
 hora_candidatura TIME NOT NULL,
 idprofessor INT NOT NULL,
 idstatus_candidatura INT NOT NULL,
 idturma INT NOT NULL
); 

